{
  "name": "pecs-desktop",
  "version": "0.6.0",
  "description": "PECS Desktop — Always-available engineering cognition OS",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "build:prod": "node esbuild.mjs --production",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "electron-builder"
  },
  "dependencies": {
    "express": "^4.19.2",
    "minisearch": "^7.1.2",
    "zod": "^3.23.8",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.8.3",
    "esbuild": "^0.25.4",
    "@types/node": "^22.0.0",
    "@types/express": "^4.17.21",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "vitest": "^3.1.4"
  },
  "build": {
    "appId": "com.pecs.desktop",
    "productName": "PECS",
    "files": ["dist/**/*", "renderer/**/*", "assets/**/*"],
    "directories": { "output": "release" },
    "mac": { "category": "public.app-category.developer-tools" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" }
  }
}
